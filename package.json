{
  "name": "biblioteca-matematica",
  "version": "1.0.0",
  "description": "Biblioteca digital de Matemática para o Ensino Fundamental II — lições guiadas de frações.",
  "main": "server.js",
  "keywords": [
    "educacao",
    "matematica",
    "ensino-fundamental"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "nodemon": "^3.1.4",
    "jsdom": "^30.0.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "tsc",
    "dev:build": "tsc --watch",
    "imagens": "node ferramentas/gerar-imagens.mjs",
    "test": "npm run build && node tests/conteudo.test.mjs && node tests/motor.test.mjs && node tests/pagina.test.mjs",
    "videos": "node ferramentas/verificar-videos.mjs",
    "figuras": "node ferramentas/auditar-figuras.mjs"
  }
}
